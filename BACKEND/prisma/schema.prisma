generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  firstName      String
  lastName       String
  email          String    @unique
  passwordHash   String?
  emailVerified  Boolean   @default(false)
  otp            String?
  otpExpiry      DateTime?
  resetOtp       String?
  resetOtpExpiry DateTime?
  photo          String?
  phone          String?
  location       String?
  title          String?
  linkedin       String?
  github         String?
  portfolio      String?
  summary        String?   @db.Text
  avatarColor    String?
  skills         String[]  @default([])
  onboarded      Boolean   @default(false)
  role           String    @default("normal user")
  proExpiresAt   DateTime?
  googleId       String?   @unique
  lastNameChange DateTime?
  salaryExpectation String?
  salaryCurrency    String?
  visaStatus        String?
  noticePeriod      String?
  workPreference    String?
  relocationOpen    Boolean   @default(false)
  learningConsent   Boolean   @default(false)
  createdAt      DateTime  @default(now())

  planTier           String  @default("basic")
  credits            Int     @default(20)
  bonusCredits       Int     @default(0)
  creditPeriod       String?
  liveMarketSearches Int     @default(0)
  liveMarketPeriod   String?

  banned       Boolean @default(false)
  bannedReason String?
  lastIp       String?
  sessionsValidFrom DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  cvs                CV[]
  chats              Chat[]
  paymentRequests    PaymentRequest[]
  jobPreference      JobPreference?
  jobMatches         JobMatch[]
  jobRoleSuggestions JobRoleSuggestion[]
  jobSubmissions     JobSubmission[]
  variants           CVVariant[]
  documents          Document[]
  careerMatchCaches  CareerMatchCache[]
  reviews            Review[]
  skillProgress      UserSkillProgress[]
  gitHostCredentials GitHostCredential[]
  extensionAnswers   ExtensionAnswer[]
  blogComments       BlogComment[]
}

model SkillRoadmap {
  id           String   @id @default(uuid())
  skillKey     String   @unique
  skill        String
  category     String   @default("skill")
  officialDocs Json?
  playground   Json?
  projectIdeas String[] @default([])
  courseLinks  Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userProgress UserSkillProgress[]

  @@index([skillKey])
}

model UserSkillProgress {
  id             String       @id @default(uuid())
  userId         String
  skillRoadmapId String
  status         String       @default("in_progress")
  learnedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillRoadmap SkillRoadmap @relation(fields: [skillRoadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, skillRoadmapId])
  @@index([userId, status])
}

model CareerMatchCache {
  id             String   @id @default(uuid())
  userId         String
  cacheKey       String
  response       Json
  usesLiveSearch Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cacheKey])
  @@index([expiresAt])
}

model JobPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  role      String
  roleIds   String[] @default([])
  level     String?
  location  String?
  remote    Boolean  @default(false)
  keywords  String?
  blocklist String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobMatch {
  id          String    @id @default(uuid())
  userId      String
  source      String
  externalId  String
  title       String
  company     String
  location    String?
  url         String
  postedAt    DateTime?
  fitScore    Int?
  analysisStatus String @default("available")
  earlyBird   Boolean   @default(false)
  status      String    @default("matched")
  coverLetter String?
  coverLetterAr String?
  checklist          Json?
  screeningAnswers   Json?
  notes              String?
  reminderAt         DateTime?
  reminderSent       Boolean   @default(false)
  workspaceData      Json?
  selectedCvVariant  String?
  appliedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, status])
}

model Job {
  id          String    @id @default(uuid())
  source      String
  externalId  String
  title       String
  company     String
  location    String?
  country     String?
  dedupeKey   String    @default("")
  remote      Boolean   @default(false)
  url         String
  postedAt    DateTime?
  description String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([dedupeKey])
  @@index([country, postedAt])
  @@index([createdAt])
}

model JobBoardSource {
  id         String    @id @default(uuid())
  provider   String
  slug       String
  company    String
  country    String?
  active     Boolean   @default(true)
  lastRunAt  DateTime?
  lastJobCount Int     @default(0)
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([provider, slug])
  @@index([provider, active])
}

model ExtensionAnswer {
  id            String   @id @default(uuid())
  userId        String
  questionHash  String
  questionLabel String
  answer        String   @db.Text
  source        String   @default("generated")
  edited        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionHash])
  @@index([userId, updatedAt])
}

model ExtensionPairing {
  id         String    @id @default(uuid())
  code       String    @unique
  userId     String?
  approvedAt DateTime?
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id              String       @id @default(uuid())
  userId          String
  displayName     String
  rating          Int
  description     String       @db.Text
  status          ReviewStatus @default(PENDING)
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

model AnalysisEvent {
  id        String   @id @default(uuid())
  userId    String?
  ip        String?
  createdAt DateTime @default(now())

  // How well we read the uploaded file. No CV content is stored — these are measurements about the
  // extraction, not about the person. They answer one question: how often do we misread a CV, and
  // which tools produce the files we misread.
  producer       String?
  creator        String?
  pages          Int?
  charsPerPage   Int?
  lineClustering  Float?
  experienceFound Boolean?
  datesParsed     Boolean?
  suspect         Boolean?
  score           Int?

  @@index([createdAt])
  @@index([suspect])
  @@index([datesParsed])
}

enum JobSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model JobSubmission {
  id          String              @id @default(uuid())
  userId      String
  title       String
  company     String
  location    String?
  remote      Boolean             @default(false)
  url         String
  description String              @db.Text
  status      JobSubmissionStatus @default(PENDING)
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
model JobCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  nameAr    String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  roles     JobRole[]
}

model JobRole {
  id         String      @id @default(uuid())
  categoryId String
  name       String
  nameAr     String
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  category   JobCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
  @@index([categoryId, active])
}

enum JobRoleSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model JobRoleSuggestion {
  id           String                  @id @default(uuid())
  userId       String
  categoryName String
  roleName     String
  note         String?
  status       JobRoleSuggestionStatus @default(PENDING)
  reviewedAt   DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model CVVariant {
  id            String   @id @default(uuid())
  userId        String
  jobMatchId    String
  label         String
  content       String   @db.Text
  sentCount     Int      @default(0)
  responseCount Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IpAnalysisUsage {
  ip        String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model BannedIp {
  ip        String   @id
  reason    String?
  createdAt DateTime @default(now())
}

model AiUsage {
  day             String
  model           String
  tokens          Int       @default(0)
  calls           Int       @default(0)
  lastRateLimitAt DateTime?

  @@id([day, model])
}

model Blog {
  id         String   @id @default(uuid())
  slug       String   @unique
  title      String
  excerpt    String
  content    String   @db.Text
  coverImage String?
  category   String   @default("General")
  published  Boolean  @default(true)
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comments BlogComment[]

  @@index([published, createdAt])
}

model BlogComment {
  id          String   @id @default(uuid())
  blogId      String
  userId      String
  displayName String
  content     String   @db.Text
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([blogId, approved, createdAt])
}

model CV {
  id            String   @id @default(uuid())
  userId        String
  title         String?
  template      String   @default("classic-cv")
  personalInfo  Json
  experience    Json
  education     Json
  projects      Json     @default("[]")
  skills        Json
  sectionOrder  Json?
  customSections Json?
  fontScale     Float    @default(1)
  sectionGap    Float    @default(1)
  cloudinaryUrl String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary])
}

// Prose documents (cover letters, LinkedIn bios) — text-based, distinct from structured CVs.
model Document {
  id            String   @id @default(uuid())
  userId        String
  type          String
  title         String
  content       String   @db.Text
  targetRole    String?
  targetCompany String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Chat {
  id        String   @id @default(uuid())
  userId    String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Plans ────────────────────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(uuid())
  slug         String   @unique
  displayName  String
  priceEGP     Decimal  @db.Decimal(10, 2)
  durationDays Int
  tier         String   @default("pro")
  kind         String   @default("subscription")
  grantCredits Int      @default(0)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  paymentRequests PaymentRequest[]

  @@map("plans")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model PaymentRequest {
  id                   String              @id @default(uuid())
  userId               String
  planId               String?
  // Snapshot of price at purchase time — plan price may change later
  amountSnapshot       Decimal             @db.Decimal(10, 2)
  purchaseKind         PaymentPurchaseKind @default(SUBSCRIPTION)
  grantCreditsSnapshot Int                 @default(0)
  pricingVersion       String?
  currency             String              @default("EGP")
  status               PaymentStatus       @default(PENDING)
  // One InstaPay transfer can fund exactly one request — without this an approved
  // reference could be resubmitted and credited again, on any account.
  referenceNumber      String?             @unique
  screenshotUrl        String?
  method               PaymentMethod       @default(INSTAPAY)
  rejectionReason      String?
  // Snapshot of who decided, not a relation: the audit answer must survive the
  // reviewer changing their email or leaving.
  reviewedByEmail      String?
  reviewedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])

  @@map("payment_requests")
}

enum PaymentPurchaseKind {
  SUBSCRIPTION
  FIXED_TOPUP
  CUSTOM_TOPUP
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  INSTAPAY
}

model GitHostCredential {
  id        String   @id @default(uuid())
  userId    String
  host      GitHost
  token     String   @db.Text
  hint      String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, host])
  @@map("git_host_credentials")
}

enum GitHost {
  GITHUB
  GITLAB
}

model AiCache {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())

  @@map("ai_cache")
}

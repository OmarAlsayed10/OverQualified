{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/server.js",
    "start:win": "npm run build && set NODE_OPTIONS=--max-old-space-size=512 && node dist/server.js",
    "dev": "nodemon src/server.ts",
    "seed:admin": "ts-node prisma/seedAdmin.ts",
    "db:preflight": "node dist/scripts/preDeployChecks.js",
    "db:deploy": "prisma migrate deploy",
    "test": "jest --verbose",
    "vercel-build": "npm run build",
    "check": "ts-node src/scripts/runChecks.ts",
    "check:ci": "ts-node src/scripts/runChecks.ts --no-browser",
    "check:boot": "npm run build && node dist/scripts/bootCheck.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sparticuz/chromium": "^131.0.1",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.3.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "openai": "^4.95.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfjs-dist": "^6.2.108",
    "prisma": "^5.22.0",
    "puppeteer-core": "^23.11.1",
    "unpdf": "^1.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.14",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
